{
  "out": "docs",
  "entryPoints": [
    "./src/classes/",
    "./src/dist.ts",
    "./src/types/",
    "./src/data/namespaces.ts",
    "./src/data/schemaModules.ts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "./src/tsconfig.json",
  "disableSources": true,
  "hideGenerator": true,
  "customCss": "./docu/typedoc.css",
  "readme": "./docu/docuReadme.md",
  "name": "Schema.org Adapter",
  "plugin": ["typedoc-plugin-merge-modules"],
  "mergeModulesRenameDefaults": true,
  "mergeModulesMergeMode": "project"
}