{
  "name": "schema-org-adapter",
  "version": "7.1.1",
  "engines": {
    "node": ">=10.0.0"
  },
  "description": "Fast, simple & flexible API for the Schema.org Vocabulary (and vocabulary extensions!) for Node and Browsers",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "prebuild": "rimraf lib",
    "buildAll": "npm run-script prebuild && npm run-script buildTs && npm run-script buildDist && npm run-script buildDistMinified",
    "buildTs": "tsc -b src",
    "buildDist": "browserify lib/dist.js -p esmify -s SOA > dist/schema-org-adapter.js",
    "buildDistMinified": "browserify lib/dist.js -p esmify -s SOA | terser --compress --mangle > dist/schema-org-adapter.min.js",
    "testSemantifyRepo": "COMMIT=SEMANTIFY jest",
    "testSoaRepo": "jest",
    "testSchemaRepo": "COMMIT=d5ed5b8de39127c42cc7e252f242e4eb5e862996 jest",
    "testSchemaRepoInfra": "COMMIT=d5ed5b8de39127c42cc7e252f242e4eb5e862996 jest tests/classes/Infrastructure.test.ts",
    "buildTestExperimental1": "tsc tests/experimental/vocabulary-comparison.ts",
    "runTestExperimental1": "node tests/experimental/vocabulary-comparison.js",
    "eslint-check": "eslint src/**/*.ts tests/**/*.ts",
    "eslint-repair": "eslint --fix src/**/*.ts tests/**/*.ts",
    "prettier-check": "prettier --check src/**/*.ts tests/**/*.ts",
    "prettier-repair": "prettier --write src/**/*.ts tests/**/*.ts",
    "genTypeDoc": "typedoc",
    "watchTypeDoc": "typedoc --watch",
    "watchTs": "tsc -b src --watch",
    "vulnerabilities": "npm audit --audit-level=critical --registry=https://registry.npmjs.org --omit=dev"
  },
  "author": {
    "name": "Omar J. A. Holzknecht for STI Innsbruck",
    "url": "https://semantify.it"
  },
  "license": "Apache-2.0",
  "homepage": "https://semantifyit.github.io/schema-org-adapter/",
  "keywords": [
    "schema.org",
    "adapter",
    "schema",
    "org",
    "converter",
    "sdo-adapter",
    "semantic web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/semantifyit/schema-org-adapter"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "jsonld": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/jsonld": "^1.5.15",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "browserify": "^17.0.1",
    "deep-object-diff": "^1.1.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "esmify": "^2.1.1",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "terser": "^4.8.1",
    "ts-jest": "^29.4.1",
    "typedoc": "^0.28.12",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest/presets/js-with-ts",
    "testEnvironment": "node",
    "testTimeout": 300000,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "docu/coverage",
    "coverageReporters": [
      "json-summary"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tests/tsconfig.json"
        }
      ]
    }
  },
  "files": [
    "lib/*",
    "dist/*",
    "README.md",
    "History.md",
    "LICENSE",
    "package.json"
  ],
  "prettier": {
    "printWidth": 120,
    "trailingComma": "none"
  }
}
